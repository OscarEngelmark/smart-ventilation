# Personal Claude Code notes
CLAUDE.local.md

# Raw Canvas page exports, not meant for redistribution.
canvas/

# Go
/bin/
*.exe
*.test
*.out

# Python (prototyping/scripts, if any)
__pycache__/
*.pyc
.venv/
venv/

# LaTeX build artifacts (regenerated by `make` or latexmk; the report builds into build/)
*.aux
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.log
*.pdf
latex/report/build/

# Rendered diagrams (regenerated from the .d2 sources)
diagrams/*.svg
latex/report/figures/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Private scratch files (e.g. equations to view in Markdown preview)
scratch/

# Clock of the current session, written by start.sh
run.env

# History store snapshots for evaluation runs, written by eval/snapshot.sh
eval/snapshots/
