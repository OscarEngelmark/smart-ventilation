# Simulation parameters shared by more than one service, so that each value
# is written once and every service reads the same number. Values that
# BuildSim already holds (room area, damper state, CO2) are read from
# BuildSim instead and never appear here. See project_notes.md §6.
#
# Only the values the services built so far actually use are listed; the
# rest of the physical model's parameters join them as it is written.

# The room the first end-to-end loop runs in.
ROOM_LEVEL=level0
ROOM_NAME=A125

# Floor area one person is assumed to occupy, used with the room's area from
# BuildSim to get how many people the room holds. An estimate, not sourced.
AREA_PER_PERSON_M2=5

# Wall-clock timezone the simulated day runs on, so the schedule's office
# hours line up with local time.
TZ=Europe/Stockholm
