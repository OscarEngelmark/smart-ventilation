# Simulation parameters shared by more than one service, so that each value
# is written once and every service reads the same number. Values that
# BuildSim already holds (room area, damper state, CO2) are read from
# BuildSim instead and never appear here. See project_notes.md §6.
#
# Only the values the services built so far actually use are listed; the
# forecast horizon joins them with the forecast service.

# The room the first end-to-end loop runs in.
ROOM_LEVEL=level0
ROOM_NAME=A125

# The CO2 sensor device in BuildSim. The physical model writes its value and
# the sensor process reads it back, so both must name the same device.
CO2_SENSOR_ID=A125-co2

# Floor area one person is assumed to occupy, used with the room's area from
# BuildSim to get how many people the room holds. An estimate, not sourced.
AREA_PER_PERSON_M2=5

# Room height, which turns the room's floor area into its air volume.
# BuildSim gives no height; this is the minimum Swedish workplace rules
# advise, so it gives the fastest plausible CO2 rise.
CEILING_HEIGHT_M=2.4

# CO2 one seated person breathes out.
CO2_PER_PERSON_LPS=0.0056

# CO2 of the outdoor air the ventilation brings in, and the level the room
# decays toward when it is empty.
OUTDOOR_CO2_PPM=420

# The level the room should stay below. The decision service ventilates to
# hold the forecast under it.
CO2_THRESHOLD_PPM=1000

# Ventilation with the damper fully closed, per m² of floor area: the
# building's background airflow, which never stops.
MIN_AIRFLOW_LPS_PER_M2=0.35

# How much larger the fully open airflow is than the airflow that would just
# hold a full room at the threshold. 1 would hold the room exactly at it; 2
# settles a full room about halfway between outdoor air and the threshold.
MAX_AIRFLOW_FACTOR=2

# How much room time each cycle of the physical model advances CO2 by. Room
# time is the wall clock, so this is also how often the model runs.
SIM_STEP=10s

# Wall-clock timezone the simulated day runs on, so the schedule's office
# hours line up with local time.
TZ=Europe/Stockholm
