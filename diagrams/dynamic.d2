# Dynamic diagram: a fifth person arrives for the meeting in A125 on
# 2026-11-19 and the damper opens before their CO2 builds up. Times are
# room time in Stockholm; the stored data holds them in UTC, an hour earlier.
# Participants are named as in container.d2. Dashed arrows are answers.
# Stored data: test/results/scenario_arrival_2026-11-19_*.json.
shape: sequence_diagram

occ: "Occupancy simulator"
model: "Physical model"
bs: "BuildSim"
actuator: "Damper actuator"
occsensor: "Occupancy sensor"
co2sensor: "CO2 sensor"
broker: "Message broker"
decision: "Decision service"
storage: "Storage service"

occ -> bs: "1. move a person into A125 [REST]"
occsensor -> bs: "2. read the room's occupancy [REST]"
bs -> occsensor: "5 people" {style.stroke-dash: 4}
occsensor -> broker: "3. head count 5, 13:02:34 [MQTT]"
broker -> decision: "4. head count 5, kept as the latest"
broker -> storage: "5. head count 5, stored"
model -> bs: "6. read N = 5, damper 0.55, CO2; write the new CO2 [REST]"
co2sensor -> bs: "7. read the sensor's value [REST]"
bs -> co2sensor: "853.5 ppm" {style.stroke-dash: 4}
co2sensor -> broker: "8. CO2 853.5 ppm, 13:02:44 [MQTT]"
broker -> decision: "9. CO2 853.5 ppm"
broker -> storage: "10. CO2 853.5 ppm, stored"
decision -> decision: "11. plan with 5 people: 0.55 -> 0.75"
decision -> actuator: "12. PUT /command, level 0.75 [REST]"
actuator -> bs: "13. set the damper to 0.75 [REST]"
actuator -> decision: "200" {style.stroke-dash: 4}
decision -> broker: "14. command 0.75, 13:02:44 [MQTT]"
broker -> storage: "15. command 0.75, stored"
model -> bs: "16. next step reads damper 0.75 [REST]"
